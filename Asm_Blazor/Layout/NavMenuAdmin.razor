@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject Asm_Blazor.Services.AuthService AuthService

<nav class="navbar navbar-expand-lg bg-primary navbar-dark shadow-sm sticky-top px-4 py-2">
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="/img/logo.png" alt="Logo" style="height: 60px;" class="me-2" />
            <strong class="fs-4 text-white">BooBoo Store</strong>
        </a>

        <!-- Toggle button for mobile -->
        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse @(collapseNavMenu ? "" : "show")">



            <li class="nav-item"><NavLink class="nav-link text-white" href="/admin/books">Quản lý Sách</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link text-white" href="/">Sách điện tử</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link text-white" href="/">Gian hàng</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link text-white" href="/">Tin tức</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link text-white" href="/">Đơn hàng</NavLink></li>
         

            <!-- Góc phải: giỏ hàng + user -->
            <ul class="navbar-nav ms-auto gap-3 align-items-center">
                <li class="nav-item position-relative">
                    <a class="text-white fs-5 text-decoration-none" href="/cart">
                        <i class="bi bi-cart3"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            0
                        </span>
                    </a>
                </li>

                @if (AuthService.IsLoggedIn)
                {
                    <li class="nav-item text-white">👋 @username</li>
                    <li class="nav-item">
                        <button class="btn btn-outline-light btn-sm" @onclick="Logout">Đăng xuất</button>
                    </li>
                }
                else
                {
                    <li class="nav-item"><NavLink class="nav-link text-white" href="/register">Đăng ký</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link text-white" href="/login">Đăng nhập</NavLink></li>
                }
            </ul>
        </div>
    </div>
</nav>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

@code {
    private string? username;
    private bool collapseNavMenu = true;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.CheckLoginStateAsync();
        username = await LocalStorage.GetItemAsync<string>("username");
    }
}
