@inject NavigationManager Nav

@inject Asm_Blazor.Services.AuthService AuthService
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
<style>
    :root {
        --primary-color: #1976D2;
        --primary-light: #BBDEFB;
        --primary-dark: #0D47A1;
        --accent-color: #42A5F5;
        --text-color: #212121;
        --bg-color: #f5f7fa;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-color);
    }

    .navbar {
        background-color: var(--primary-color) !important;
    }

    .card {
        border: none;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        transition: 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-outline-primary:hover {
            background-color: var(--primary-color);
            color: white;
        }

    a {
        text-decoration: none;
    }
</style>

<nav class="navbar navbar-expand-lg bg-primary navbar-dark shadow-sm sticky-top px-4 py-2">
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="/admin/dashboard">
            <img src="/img/logo.png" alt="Logo" style="height: 60px;" class="me-2" />
           
        </a>

        <!-- Toggle button for mobile -->
        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse @(collapseNavMenu ? "___"  : "show")">

            <li class="nav-item"><NavLink class="nav-link text-white" href="/admin/books">Quản lý Sách</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link text-white" href="/admin/categories">quản lý thể loại</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link text-white" href="/admin/users">Quản lý user</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link text-white" href="/admin/orders">Quản lý Đơn hàng</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link text-white" href="/">Đơn hàng</NavLink></li>
         

            <!-- Góc phải: giỏ hàng + user -->
            <ul class="navbar-nav ms-auto gap-3 align-items-center  " style="margin-right:40px">
                <li class="nav-item position-relative">
                    <a class="text-white fs-5 text-decoration-none" href="/cart">
                        <i class="bi bi-cart3"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            0
                        </span>
                    </a>
                </li>

                @if (AuthService.IsLoggedIn)
                {
                    <li class="nav-item text-white">👋 @username</li>
                    <li class="nav-item">
                        <button class="btn btn-outline-light btn-sm" @onclick="Logout">Đăng xuất</button>
                    </li>
                }
                else
                {
                    <li class="nav-item"><NavLink class="nav-link text-white" href="/register">Đăng ký</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link text-white" href="/login">Đăng nhập</NavLink></li>
                }
            </ul>
        </div>
    </div>
</nav>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

@code {
    private string? username;
    private int? id;
    private bool collapseNavMenu = true;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.CheckLoginStateAsync();
        username = await sessionStorage.GetItemAsync<string>("username");
        id = await AuthService.GetUserIdAsync();
    }
}
