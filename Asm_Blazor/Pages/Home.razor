@page "/"
@using Asm_Blazor.Models
@using Asm_Blazor.Models.book
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Asm_Blazor.Services
@inject CartService CartService
<div id="carouselExampleFade" class="carousel slide carousel-fade mb-5" data-bs-ride="carousel" data-bs-interval="3000" >
    <div class="carousel-inner rounded shadow-lg">
        <div class="carousel-item active">
            <img src="img/side1.jpg" class="d-block w-100 rounded" alt="Ảnh 1" >
        </div>
        <div class="carousel-item">
            <img src="img/side2.jpg" class="d-block w-100 rounded" alt="Ảnh 2" >
        </div>
        <div class="carousel-item">
            <img src="img/side3.jpg" class="d-block w-100 rounded" alt="Ảnh 3" >
        </div>
        <div class="carousel-item">
            <img src="img/side4.jpg" class="d-block w-100 rounded" alt="Ảnh 4" >
        </div>
        <div class="carousel-item">
            <img src="img/side5.jpg" class="d-block w-100 rounded" alt="Ảnh 5" >
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleFade" data-bs-slide="prev">
        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleFade" data-bs-slide="next">
        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<h3 class="text-center my-4">📚 Sách Mới Nhất</h3>

@if (books == null)
{
    <div class="text-center">
        <p>Đang tải...</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var book in books)
        {
            <div class="col mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="text-center mt-2">
                        <img src="img/@book.ImageUrl" class="card-img-top" alt="@book.Title"
                             style="width: 200px; height: auto;" />
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate" title="@book.Title">@book.Title</h5>
                        <p class="card-text mb-1"><strong>Tác giả:</strong> @book.Author</p>
                        <p class="card-text mb-1"><strong>Thể loại:</strong> @book.CategoryName</p>
                        <p class="card-text text-danger fw-bold mb-3">@book.Price.ToString("N0") ₫</p>

                        <div class="mt-auto d-grid gap-2">
                            <button class="btn btn-primary" @onclick="@(() => AddToCart(book))">🛒 Thêm vào giỏ</button>
                            <a class="btn btn-outline-secondary" href="@($"/book/{book.Id}")">🔍 Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    }

@code {
    private List<BookModel> books;

    protected override async Task OnInitializedAsync()
    {
        books = await Http.GetFromJsonAsync<List<BookModel>>("https://localhost:7197/api/Book");
    }

    [Parameter]
    public BookModel Book { get; set; } = new();

    private async Task AddToCart(BookModel book)
    {
        var item = new CartItemModel
            {
                BookId = book.Id,
                Title = book.Title, 
                Price = book.Price,
				ImageUrl = book.ImageUrl,
                Quantity = 1
            };

        await CartService.AddItemAsync(item);
        NavigationManager.NavigateTo("/cart");
    }
}
