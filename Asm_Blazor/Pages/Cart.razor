@page "/cart"
@inject Asm_Blazor.Services.CartService CartService
@inject Asm_Blazor.Services.OrderService OrderService
@inject Asm_Blazor.Services.AuthService AuthService
@using Asm_Blazor.Models
@using Asm_Blazor.Models.book;
@using Asm_Blazor.Models.order;
@using System.Net.Http.Json;
@using System.Text.Json;
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService localStorage
@inject IJSRuntime JS

<h3>Giỏ hàng</h3>

@if (Cartt?.Count == 0)
{
    <p>Không có sản phẩm nào trong giỏ hàng</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sách</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Tổng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Cartt)
            {
                <tr>
                    <td><img src="img/@item.ImageUrl" class="card-img-top" alt="Alternate Text" style="width:100px;height:auto" /></td>
                    <td>@item.Title</td>
                    <td>@item.Price.ToString("N0") ₫</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => DecreaseQuantity(item.BookId)" disabled="@isUpdating">-</button>
                            <span>@item.Quantity</span>
                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => IncreaseQuantity(item.BookId)" disabled="@isUpdating">+</button>
                        </div>
                    </td>
                    <td>@((item.Price * item.Quantity).ToString("N0")) ₫</td>
                    <td>
                        <button class="btn btn-danger" @onclick="() => RemoveItem(item.BookId)">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Tổng cộng: @Total.ToString("N0") ₫</h4>
    <button class="btn btn-warning" @onclick="ClearCart">Xóa toàn bộ</button>
    <button class="btn btn-primary" @onclick="InitiatePayment">Thanh Toán chuyển khoản</button>
    <button class="btn btn-success" @onclick="CreateCashOrder">Thanh Toán tiền mặt</button>
}

@code {
    List<CartItemModel> Cartt = new();
    bool isUpdating = false;

    int Total => Cartt.Sum(x => x.Price * x.Quantity);

    protected override async Task OnInitializedAsync()
    {
        Cartt = await CartService.GetCartAsync();
    }

    async Task RemoveItem(int id)
    {
        await CartService.RemoveItemAsync(id);
        Cartt = await CartService.GetCartAsync();
        await JS.InvokeVoidAsync("alert", "Đã xóa sản phẩm khỏi giỏ hàng!");
    }

    async Task ClearCart()
    {
        await CartService.ClearCartAsync();
        Cartt = await CartService.GetCartAsync();
        await JS.InvokeVoidAsync("alert", "Đã xóa toàn bộ giỏ hàng!");
    }

    async Task IncreaseQuantity(int bookId)
    {
        isUpdating = true;
        await CartService.IncreaseQuantityAsync(bookId);
        Cartt = await CartService.GetCartAsync();
        isUpdating = false;
        await JS.InvokeVoidAsync("console.log", "Tăng số lượng thành công");
    }

    async Task DecreaseQuantity(int bookId)
    {
        isUpdating = true;
        await CartService.DecreaseQuantityAsync(bookId);
        Cartt = await CartService.GetCartAsync();
        isUpdating = false;
        await JS.InvokeVoidAsync("console.log", "Giảm số lượng thành công");
    }

    // Tạo đơn hàng chuyển khoản
    private async Task InitiatePayment()
    {
        var paymentRequest = new VnPayModel
            {
                Amount = Total
            };

        var token = await localStorage.GetItemAsync<string>("authToken");

        if (!Http.DefaultRequestHeaders.Contains("Authorization"))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var response = await Http.PostAsJsonAsync("https://4965-171-250-162-59.ngrok-free.app/api/payment/create-payment", paymentRequest);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<JsonElement>();
            if (result.TryGetProperty("url", out var paymentUrlElement))
            {
                var paymentUrl = paymentUrlElement.GetString();
                if (!string.IsNullOrEmpty(paymentUrl))
                {
                    Navigation.NavigateTo(paymentUrl);
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Không nhận được URL thanh toán");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Phản hồi không chứa URL thanh toán");
            }
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Lỗi khi tạo thanh toán");
        }
    }

    // Tạo đơn hàng tiền mặt
    private async Task CreateCashOrder()
    {
        var cart = await CartService.GetCartAsync();

        if (cart == null || !cart.Any())
        {
            await JS.InvokeVoidAsync("alert", "Giỏ hàng rỗng");
            return;
        }

        var userId = await AuthService.GetUserIdAsync();

        if (userId == null)
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng đăng nhập trước khi thanh toán.");
            Navigation.NavigateTo("/login");
            return;
        }

        var order = new OrderCreateModel
            {
                UserId = userId.Value,
                Items = cart.Select(item => new OrderItemCreateModel
                {
                    BookId = item.BookId,
                    Quantity = item.Quantity
                }).ToList()
            };

        var success = await OrderService.CreateOrderAsync(order);

        if (success)
        {
            await CartService.ClearCartAsync();
            Cartt = await CartService.GetCartAsync();
            await JS.InvokeVoidAsync("alert", "Đặt hàng thành công!");
            Navigation.NavigateTo("/orders");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Đặt hàng thất bại!");
        }
    }
}
