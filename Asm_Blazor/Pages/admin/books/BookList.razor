@page "/admin/books"
@inject Asm_Blazor.Services.BookService BookService
@inject NavigationManager Navigation
@using Asm_Blazor.Models;
@using Asm_Blazor.Models.book
@layout AdminLayout



<h3>📚 Danh sách Sách</h3>

<button class="btn btn-success mb-3" @onclick="@(() => Navigation.NavigateTo("/admin/books/create"))">
    + Thêm sách
</button>

<table class="table table-striped mt-4">
    <thead class="table-dark">
        <tr>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Giá</th>
            <th>Số lượng</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Price</td>
                <td>@book.Quantity</td>
                <td>
                  
                    <button class="btn btn-warning me-1" @onclick="@(() => Navigation.NavigateTo($"/admin/books/edit/{book.Id}"))">Sửa</button>
                    <button class="btn btn-danger" @onclick="() => Delete(book.Id)">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    List<BookModel> books = new();

    protected override async Task OnInitializedAsync()
    {
        books = await BookService.GetBooksAsync();
    }

    async Task Delete(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Xác nhận xóa sách ID {id}?"))
        {
            await BookService.DeleteBookAsync(id);
            books = await BookService.GetBooksAsync();
        }
    }

    [Inject] IJSRuntime JS { get; set; } = default!;
}
