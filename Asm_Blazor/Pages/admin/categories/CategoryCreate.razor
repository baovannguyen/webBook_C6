@page "/admin/categories/create"
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Asm_Blazor.Models

<h3>➕ Thêm Danh Mục</h3>

<div class="card p-4 shadow rounded-3">
    <div class="mb-3">
        <label class="form-label">Tên danh mục</label>
        <input class="form-control" @bind="category.Name" placeholder="Nhập tên danh mục" />
    </div>

    <button class="btn btn-success me-2" @onclick="CreateCategory">Lưu</button>
    <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/admin/categories"))">Hủy</button>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
</div>

@code {
    private CategoryModel category = new(); 
    private string? successMessage;

    private async Task CreateCategory()
    {

		if (string.IsNullOrEmpty(category.Name))
		{
			await JS.InvokeVoidAsync("alert", "Vui lòng nhập tên danh mục!");
			return;
		}
        

        await CategoryService.CreateCategoryAsync(category);
        successMessage = "Thêm sách thành công!";
        await JS.InvokeVoidAsync("alert", successMessage);
        Navigation.NavigateTo("/admin/categories");
    }

    }
}
