@page "/admin/users"
@inject Asm_Blazor.Services.UserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Asm_Blazor.Models
@layout AdminLayout
<h3>👤 Quản lý người dùng</h3>

<button class="btn btn-success mb-3" @onclick="@(() => Navigation.NavigateTo("/admin/users/create"))">
    ➕ Thêm người dùng
</button>

@if (users == null)
{
    <p>Đang tải dữ liệu...</p>
}
else if (!users.Any())
{
    <p>Không có người dùng nào.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Họ tên</th>
                <th>Tên đăng nhập</th>
                <th>Vai trò</th>
                <th>Số điện thoại</th>
                <th>Ngày sinh</th>
                <th>Địa chỉ</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Username</td>
                    <td>@user.Role</td>
                    <td>@user.PhoneNumber</td>
                    <td>@(user.DateOfBirth?.ToString("dd/MM/yyyy"))</td>
                    <td>@user.Address</td>
                    <td>
                        <button class="btn btn-sm btn-primary me-2" @onclick="@(() => EditUser(user.Id))">✏️ Sửa</button>
                        <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteUser(user.Id))">🗑 Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Asm_Blazor.Models.UserModel> users;

    protected override async Task OnInitializedAsync()
    {
        users = await UserService.GetUsersAsync();
    }



    private void EditUser(int id)
    {
        Navigation.NavigateTo($"/admin/users/edit/{id}");
    }

    private async Task DeleteUser(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa người dùng này?");
        if (confirmed)
        {
            var result = await UserService.DeleteUserAsync(id);
            if (result)
            {
                users = await UserService.GetUsersAsync();
                await JS.InvokeVoidAsync("alert", "✅ Đã xóa người dùng.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ Xóa thất bại.");
            }
        }
    }
}
